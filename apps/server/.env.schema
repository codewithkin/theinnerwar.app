# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=if($VERCEL_ORIGIN, "${VERCEL_ORIGIN}/api/auth", undefined)

# @public @dynamic @type=url
CORS_ORIGIN=$VERCEL_ORIGIN

# @type=string(minLength=1)
DATABASE_URL=

# Public base URL of this server, used for links inside emails (tracking,
# one-click unsubscribe). On Vercel the server is mounted under /api.
# @public @dynamic @type=url
SERVER_PUBLIC_URL=if($VERCEL_ORIGIN, "${VERCEL_ORIGIN}/api", undefined)

# --- Mail: two Spacemail mailboxes over SMTP (nodemailer) ---
# mail.spacemail.com:465 with implicit TLS. Each mailbox signs in as itself.
# The SMTP login is an email address; only the passwords are secret.

# noreply@theinnerwar.app: account mail (magic links, sign-in, account notices).
# @required=false @sensitive=false
NOREPLY_SMTP_HOST=mail.spacemail.com
# @required=false @sensitive=false @type=port
NOREPLY_SMTP_PORT=465
# true for implicit TLS (port 465); false uses STARTTLS (port 587).
# @required=false @sensitive=false @type=boolean
NOREPLY_SMTP_SECURE=true
# @required=false @sensitive=false
NOREPLY_SMTP_USER=
# @required=false
NOREPLY_SMTP_PASSWORD=
# "Display Name <noreply@theinnerwar.app>"
# @required=false @sensitive=false
NOREPLY_MAIL_FROM=

# newsletter@theinnerwar.app: the newsletter (welcome email, broadcasts, tests).
# When NEWSLETTER_SMTP_HOST is empty, signups are still recorded but no mail is sent.
# @required=false @sensitive=false
NEWSLETTER_SMTP_HOST=mail.spacemail.com
# @required=false @sensitive=false @type=port
NEWSLETTER_SMTP_PORT=465
# @required=false @sensitive=false @type=boolean
NEWSLETTER_SMTP_SECURE=true
# @required=false @sensitive=false
NEWSLETTER_SMTP_USER=
# @required=false
NEWSLETTER_SMTP_PASSWORD=
# "Display Name <newsletter@theinnerwar.app>"
# @required=false @sensitive=false
NEWSLETTER_MAIL_FROM=
# @required=false @sensitive=false
NEWSLETTER_MAIL_REPLY_TO=

# Newsletter log verbosity: debug shows every send, open, lookup and admin request.
# @required=false @sensitive=false @type=enum(debug, info, warn, error)
LOG_LEVEL=info

# --- Broadcast sending ---
# Deliveries sent per runner tick (one tick a minute). Gmail allows ~500/day.
# @required=false @sensitive=false @type=number
NEWSLETTER_SEND_BATCH=20
# Tick the send queue inside this process. Off on Vercel, where the cron runs it.
# @required=false @sensitive=false @type=boolean
NEWSLETTER_RUNNER=if($VERCEL_ENV, false, true)
# Bearer token for GET /n/cron (Vercel Cron sends it automatically).
# @required=false
CRON_SECRET=

# --- Dispatch (internal newsletter tool) admin sign-in ---
# Origin of the Dispatch app, allowed by CORS (e.g. https://dispatch.innerwar.app).
# @required=false @sensitive=false @type=url
DISPATCH_ORIGIN=
# @required=false @sensitive=false
DISPATCH_ADMIN_EMAIL=
# @required=false
DISPATCH_ADMIN_PASSWORD=
