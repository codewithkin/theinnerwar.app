# apps/server: the Hono + tRPC API, Better Auth, and the newsletter backend.
# Copy to .env and fill in. Validated at startup by Varlock against .env.schema.
# packages/db reads DATABASE_URL from here too (prisma.config.ts).

NODE_ENV=production

# --- Core ---

# Postgres connection string, e.g. postgresql://USER:PASSWORD@localhost:5432/theinnerwar
DATABASE_URL=postgres://postgres:sZSgMfBtsAG2yv3CcINaUfvba39w2ZqhMj02WlHZKDFpvLvOQSK4hVKN1D59Qeo6@ms1iixv8vkcrktposftjmcg2:5432/postgres

# Long random string (32+ chars). Signs auth sessions and newsletter links.
# Generate one with: openssl rand -base64 48
BETTER_AUTH_SECRET=2099726524da7c2aca0be9a11c4335a0a8cb80f6bff53fb1414a24f212f387e0

# Public base URL of this server. Locally http://localhost:3000.
# On Vercel it is derived automatically from the deployment URL.
BETTER_AUTH_URL=https://api.theinnerwar.app

# Origin of the website (apps/web), allowed by CORS. Also the base for
# unsubscribe links in emails (<CORS_ORIGIN>/unsubscribe).
CORS_ORIGIN=https://theinnerwar.app

# Public base URL of this server as email recipients reach it: open-tracking
# pixel, click redirects and one-click unsubscribe. Must be reachable from the
# internet for opens/clicks to be recorded (localhost only works for you).
SERVER_PUBLIC_URL=https://api.theinnerwar.app

# Newsletter log verbosity: debug | info | warn | error
LOG_LEVEL=info

# --- Mail: two Spacemail mailboxes, sent through nodemailer over SMTP ---
# Spacemail's SMTP endpoint is mail.spacemail.com on port 465 with implicit
# TLS ("SSL"), so SECURE is true. Each mailbox signs in as itself: USER is the
# full mailbox address and PASSWORD is that mailbox's password. FROM is the
# sender readers see, "Display Name <address>", and must be the same mailbox.

# noreply@theinnerwar.app: account mail (magic links, sign-in, account and
# data notices). Never used for the newsletter.
NOREPLY_SMTP_HOST=mail.spacemail.com
NOREPLY_SMTP_PORT=465
NOREPLY_SMTP_SECURE=true
NOREPLY_SMTP_USER=noreply@theinnerwar.app
NOREPLY_SMTP_PASSWORD=
NOREPLY_MAIL_FROM="SENDER NAME <noreply@theinnerwar.app>"

# newsletter@theinnerwar.app: the newsletter (welcome email, broadcasts, tests).
# With NEWSLETTER_SMTP_HOST empty, signups are still recorded but no mail is sent.
NEWSLETTER_SMTP_HOST=mail.spacemail.com
NEWSLETTER_SMTP_PORT=465
NEWSLETTER_SMTP_SECURE=true
NEWSLETTER_SMTP_USER=newsletter@theinnerwar.app
NEWSLETTER_SMTP_PASSWORD=
NEWSLETTER_MAIL_FROM="SENDER NAME <newsletter@theinnerwar.app>"
# Optional address replies to the newsletter go to.
NEWSLETTER_MAIL_REPLY_TO=

# --- Broadcast sending ---
# Deliveries sent per runner tick (one tick a minute). Keep it under the
# mailbox provider's hourly/daily sending limit.
NEWSLETTER_SEND_BATCH=400
# Run the send queue inside this process (Docker, local). Leave unset on
# Vercel, where the cron in vercel.json calls GET /n/cron instead.
NEWSLETTER_RUNNER=true
# Bearer token for GET /n/cron. Vercel Cron sends it automatically when set.
CRON_SECRET=

# --- Dispatch (internal newsletter app, apps/dispatch) ---
# Origin of the Dispatch app, allowed by CORS.
DISPATCH_ORIGIN=https://newsletter.theinnerwar.app
# The single admin sign-in for Dispatch.
DISPATCH_ADMIN_EMAIL=
DISPATCH_ADMIN_PASSWORD=
