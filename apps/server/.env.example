# apps/server: the Hono + tRPC API, Better Auth, and the newsletter backend.
# Copy to .env and fill in. Validated at startup by Varlock against .env.schema.
# packages/db reads DATABASE_URL from here too (prisma.config.ts).

NODE_ENV=development

# --- Core ---

# Postgres connection string, e.g. postgresql://USER:PASSWORD@localhost:5432/theinnerwar
DATABASE_URL=

# Long random string (32+ chars). Signs auth sessions and newsletter links.
# Generate one with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Public base URL of this server. Locally http://localhost:3000.
# On Vercel it is derived automatically from the deployment URL.
BETTER_AUTH_URL=http://localhost:3000

# Origin of the website (apps/web), allowed by CORS. Also the base for
# unsubscribe links in emails (<CORS_ORIGIN>/unsubscribe).
CORS_ORIGIN=http://localhost:3001

# Public base URL of this server as email recipients reach it: open-tracking
# pixel, click redirects and one-click unsubscribe. Must be reachable from the
# internet for opens/clicks to be recorded (localhost only works for you).
SERVER_PUBLIC_URL=http://localhost:3000

# Newsletter log verbosity: debug | info | warn | error
LOG_LEVEL=info

# --- Newsletter mail: nodemailer over manual SMTP ---
# With SMTP_HOST empty, signups are still recorded but no mail is sent.
# Gmail example: smtp.gmail.com, 465, true, your address, a 16-char app password.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); false uses STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to readers. Gmail only sends as the signed-in account.
MAIL_FROM="The Inner War <letters@innerwar.app>"
# Optional address replies go to.
MAIL_REPLY_TO=

# --- Broadcast sending ---
# Deliveries sent per runner tick (one tick a minute). Gmail allows ~500/day.
NEWSLETTER_SEND_BATCH=20
# Run the send queue inside this process (Docker, local). Leave unset on
# Vercel, where the cron in vercel.json calls GET /n/cron instead.
NEWSLETTER_RUNNER=true
# Bearer token for GET /n/cron. Vercel Cron sends it automatically when set.
CRON_SECRET=

# --- Dispatch (internal newsletter app, apps/dispatch) ---
# Origin of the Dispatch app, allowed by CORS.
DISPATCH_ORIGIN=http://localhost:3002
# The single admin sign-in for Dispatch.
DISPATCH_ADMIN_EMAIL=
DISPATCH_ADMIN_PASSWORD=
