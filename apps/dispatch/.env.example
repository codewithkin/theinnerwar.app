# apps/dispatch: the internal newsletter tool (Next.js). Copy to .env.
# NEXT_PUBLIC_* values are baked into the client bundle at build time
# (for Docker, pass them as --build-arg).

NODE_ENV=development

# Public base URL of apps/server. The server must list this app's origin in
# DISPATCH_ORIGIN (CORS), and sign-in uses DISPATCH_ADMIN_EMAIL /
# DISPATCH_ADMIN_PASSWORD from the server's env.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
