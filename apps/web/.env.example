# apps/web: the marketing site (Next.js). Copy to .env and fill in.
# NEXT_PUBLIC_* values are baked into the client bundle at build time
# (for Docker, pass them as --build-arg).

NODE_ENV=development

# Public base URL of apps/server. The newsletter signup form and the
# unsubscribe page call its tRPC endpoints from the browser, so the server's
# CORS_ORIGIN must be this site's origin. An absolute URL, or a path such as
# /api when the server sits behind the same domain (as on Vercel).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional override for the built-in Google Analytics measurement ID (e.g.
# G-XXXXXXXXXX). Baked into the client bundle at build time.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
